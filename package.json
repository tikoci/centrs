{
	"name": "@tikoci/centrs",
	"version": "0.1.3",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tikoci/centrs.git"
	},
	"homepage": "https://github.com/tikoci/centrs#readme",
	"bugs": "https://github.com/tikoci/centrs/issues",
	"packageManager": "bun@1.3.14",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
		"@types/bun": "^1.3.13",
		"cloc": "^2.6.0-cloc",
		"cspell": "^10.0.0",
		"has-flag": "4.0.0",
		"markdownlint-cli2": "^0.23.0",
		"secretlint": "^13.0.2",
		"typedoc": "^0.28.19"
	},
	"optionalDependencies": {
		"@tikoci/quickchr": "^0.4.7"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"exports": {
		".": "./src/index.ts",
		"./cli": "./src/cli.ts",
		"./mcp": "./src/mcp.ts",
		"./tui": "./src/tui.ts",
		"./webproxy": "./src/webproxy.ts",
		"./protocols": "./src/protocols/index.ts"
	},
	"bin": {
		"centrs": "src/cli.ts"
	},
	"description": "All-in-one TypeScript library/CLI/TUI/MCP for interacting with MikroTik RouterOS devices",
	"engines": {
		"bun": ">=1.3.11 <2"
	},
	"private": false,
	"files": [
		"src/",
		"commands/",
		"docs/CLI.md",
		"docs/CONSTITUTION.md",
		"docs/MATRIX.md",
		"docs/errors/",
		"README.md",
		"CHANGELOG.md",
		"SECURITY.md",
		"LICENSE",
		"GLOSSARY.txt"
	],
	"scripts": {
		"ci": "bun run lint:ci && bun run test && bun run build",
		"git:pre-commit": "bun run lint:git:commit",
		"git:pre-push": "bun run lint:git:push",
		"lint": "bun run lint:biome && bun run lint:typecheck",
		"lint:git:commit": "bun run lint:biome",
		"lint:git:push": "bun run lint:ci",
		"lint:ci": "bun run lint && bun run docs:cli:check && bun run explain:value-census:readme:check && bun run explain:token-census:readme:check && bun run explain:operator-readme:check && bun run lint:markdownlint && bun run lint:cspell && bun run lint:secretlint",
		"lint:cspell": "cspell lint . --gitignore",
		"lint:cspell:all": "cspell lint . --no-gitignore",
		"lint:markdownlint": "markdownlint-cli2 \"**/*.md\" \"!.scratch/**\"",
		"lint:markdownlint:fix": "markdownlint-cli2 --fix \"**/*.md\"",
		"lint:typecheck": "tsc --noEmit",
		"lint:biome": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:secretlint": "secretlint \"**/*\"",
		"test": "bun test",
		"test:smoke": "bun test test/integration/cli-smoke.test.ts",
		"test:integration:fast": "bun test test/integration/devices.test.ts test/integration/settings.test.ts",
		"test:integration:settings": "bun test test/integration/settings.test.ts",
		"test:integration:smoke": "CENTRS_RUN_FAST_INTEGRATION=1 bun test test/integration/chr-smoke.test.ts",
		"test:integration": "CENTRS_RUN_FAST_INTEGRATION=1 bun test test/integration/",
		"test:integration:stable": "CENTRS_CHR_CHANNEL=stable bun run test:integration",
		"test:integration:long-term": "CENTRS_CHR_CHANNEL=long-term bun run test:integration",
		"test:integration:testing": "CENTRS_CHR_CHANNEL=testing bun run test:integration",
		"test:integration:development": "CENTRS_CHR_CHANNEL=development bun run test:integration",
		"test:ci": "bun test --coverage",
		"test:all": "bun run test:ci",
		"check:agent": "bun run scripts/agent-check.ts",
		"corpus:fetch": "bun run scripts/corpus-fetch.ts",
		"build": "bun build src/index.ts src/cli.ts src/mcp.ts src/tui.ts src/webproxy.ts src/protocols/index.ts --outdir dist --target bun",
		"build:doc:api": "typedoc --out docs/api src/index.ts",
		"docs:cli": "bun run scripts/gen-cli-docs.ts",
		"docs:cli:check": "bun run scripts/gen-cli-docs.ts --check",
		"docs:errors": "bun run scripts/gen-error-pages.ts",
		"explain:catalog": "bun run scripts/gen-explain-catalog.ts",
		"explain:catalog:check": "bun run scripts/gen-explain-catalog.ts --check",
		"explain:corpus-census": "bun run scripts/explain-corpus-census.ts",
		"explain:highlight-slice": "bun run scripts/explain-highlight-slice.ts",
		"explain:menus": "bun run scripts/gen-explain-menus.ts",
		"explain:operator-census": "bun run scripts/explain-operator-census.ts",
		"explain:operator-census:check": "bun run scripts/explain-operator-census.ts --check",
		"explain:operator-readme": "bun run scripts/explain-operator-slice.ts --readme",
		"explain:operator-readme:check": "bun run scripts/explain-operator-slice.ts --readme --check",
		"explain:operator-slice": "bun run scripts/explain-operator-slice.ts",
		"explain:probe:brace-slots": "bun run scripts/probes/explain-brace-slot-sweep.ts",
		"explain:probe:escapes": "bun run scripts/probes/explain-escape-sweep.ts",
		"explain:probe:highlight-recapture": "bun run scripts/probes/explain-highlight-recapture.ts",
		"explain:probe:operators": "bun run scripts/probes/explain-operator-sweep.ts",
		"explain:probe:symbol-anchors": "bun run scripts/probes/explain-symbol-anchors.ts",
		"explain:probe:symbol-arms-score": "bun run scripts/probes/explain-symbol-arms-score.ts",
		"explain:probe:symbol-bad-sigil-replay": "bun run scripts/probes/explain-symbol-bad-sigil-replay.ts",
		"explain:probe:symbol-classes-replay": "bun run scripts/probes/explain-symbol-classes-replay.ts",
		"explain:probe:version-floors": "bun run scripts/probes/explain-version-floors.ts",
		"explain:menus:check": "bun run scripts/gen-explain-menus.ts --check",
		"explain:value-census": "bun run scripts/explain-value-census.ts",
		"explain:value-census:check": "bun run scripts/explain-value-census.ts --check",
		"explain:value-census:readme": "bun run scripts/explain-value-census.ts --readme",
		"explain:value-census:readme:check": "bun run scripts/explain-value-census.ts --readme --check",
		"explain:token-census": "bun run scripts/explain-token-census.ts",
		"explain:token-census:check": "bun run scripts/explain-token-census.ts --check",
		"explain:token-census:readme": "bun run scripts/explain-token-census.ts --readme",
		"explain:token-census:readme:check": "bun run scripts/explain-token-census.ts --readme --check",
		"security": "bun run lint:secretlint && bun run lint:markdownlint"
	},
	"type": "module",
	"types": "src/index.ts",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"zod": "^4.4.3"
	}
}
